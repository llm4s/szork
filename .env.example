## Copy to `.env` and fill in values locally. Do NOT commit `.env`.
## The server reads .env from its working directory, or else the directory above; a variable set in the environment
## wins over .env. A blank value counts as not set. Flags are on unless set to false, off, 0 or no.
## The README's Configuration table describes every setting.

# ---- The LLM (one is required: the server will not start without it) ----
# ANTHROPIC_API_KEY=your-anthropic-key
# OpenAI's key also gives narration, voice input and GPT Image pictures
# OPENAI_API_KEY=your-openai-key
# LLAMA_BASE_URL=http://localhost:11434/v1 # an OpenAI-compatible server, used as given: include the /v1
# Send the agents' calls to a proxy or compatible server (pictures, narration and Whisper still use OpenAI's own)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com/v1

# Provider and model. Without SZORK_LLM_PROVIDER: OpenAI if its key is set, else Anthropic, else LLAMA_BASE_URL.
# Default models: gpt-6-luna, claude-sonnet-5-5, llama3. An unknown provider stops the server.
# SZORK_LLM_PROVIDER=anthropic   # openai | anthropic | llama
# SZORK_LLM_MODEL=claude-sonnet-5-5
# How hard models that reason do so: minimal | low | medium | high | xhigh | max | default. Anything else stops the server.
# SZORK_REASONING_EFFORT=low

# ---- The Dungeon Master ----
# How much of the game's conversation each model call is sent (the system prompt is always sent; oldest turns go first)
# SZORK_DM_CONTEXT_MAX_TOKENS=24000   # 0 or off sends the whole conversation
# SZORK_DM_CONTEXT_MAX_MESSAGES=      # if set, limits by message count instead of tokens
# Prompt-injection guardrail on player commands (llm4s PromptInjectionDetector)
# SZORK_INPUT_GUARDRAIL=true
# Subagents (llm4s delegation): NPC dialogue and hints
# SZORK_NPC_AGENT=true
# SZORK_HINT_AGENT=true
# SZORK_SUBAGENT_MODEL=claude-haiku-5-5   # a model of the same provider (e.g. gpt-4o-mini on OpenAI); default: the DM's

# ---- Pictures (llm4s-image). New pictures are off until a provider is set; the library's show regardless ----
# SZORK_IMAGE_GENERATION_ENABLED=true
# SZORK_IMAGE_PROVIDER=openai   # none | openai (GPT Image) | dalle3 | dalle2 | huggingface | huggingface-sdxl | local
# SZORK_IMAGE_MODEL=gpt-image-1-mini   # the provider's model, when not its default
# SZORK_IMAGE_QUALITY=low   # GPT Image: low | medium | high | auto (low is much the cheapest and quickest)
# SZORK_IMAGE_PIXELS=1024   # the longer side pictures are kept and sent at, as JPEG
# The huggingface providers' key (or HF_API_KEY / HUGGINGFACE_TOKEN)
# HUGGINGFACE_API_KEY=your-huggingface-token
# STABLE_DIFFUSION_URL=http://localhost:7860   # or SD_URL
# STABLE_DIFFUSION_API_KEY=                    # or SD_API_KEY

# ---- Narration and voice input (OpenAI, via llm4s-speech; need OPENAI_API_KEY) ----
# SZORK_TTS_ENABLED=true
# SZORK_TTS_VOICE=nova
# SZORK_TTS_MODEL=tts-1
# SZORK_STT_ENABLED=true
# SZORK_STT_MODEL=whisper-1

# ---- Music. The library has a track for every mood; Replicate makes a missing one ----
# SZORK_MUSIC_ENABLED=true
# REPLICATE_API_KEY=your-replicate-token
# SZORK_MUSIC_POLL_MAX_ATTEMPTS=30
# SZORK_MUSIC_POLL_INTERVAL_MS=1000
# SZORK_MEDIA_CONNECT_TIMEOUT_MS=10000
# SZORK_MEDIA_READ_TIMEOUT_MS=30000

# ---- Saves, the adventure library and the media cache ----
# SZORK_AUTO_SAVE=true
# SZORK_SAVES_DIR=szork-saves
# SZORK_ADVENTURES_DIR=adventures   # docs/ADVENTURES.md
# SZORK_CACHE_ENABLED=true
# SZORK_CACHE_DIR=szork-cache
# SZORK_CACHE_TTL_MS=604800000      # 7 days
# SZORK_CACHE_MAX_BYTES=524288000   # 500 MB

# ---- The server (listens on this machine only by default; it warns if SZORK_HOST is anything else) ----
# SZORK_HOST=127.0.0.1
# SZORK_PORT=8090
# SZORK_WS_PORT=9002
# Minutes a game's session lives with no connection (a reconnect within it carries on)
# SZORK_SESSION_TTL_MINUTES=30
# Browser origins allowed to open the WebSocket and call the HTTP API (comma-separated).
# Default: http://localhost:3090, http://127.0.0.1:3090 and the same on SZORK_PORT
# SZORK_ALLOWED_ORIGINS=http://localhost:3090,http://127.0.0.1:3090
# Names the HTTP API answers to besides localhost/127.0.0.1/[::1] and SZORK_HOST (name or name:port, comma-separated);
# other Host headers are refused. Needed behind a reverse proxy that passes its own Host, or to check it with
# SZORK_HOST=0.0.0.0
# SZORK_ALLOWED_HOSTS=szork.example.lan

# ---- Tracing of the agents and image calls (off unless set): console | langfuse ----
# TRACING_MODE=langfuse
# LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
# LANGFUSE_SECRET_KEY=your-langfuse-secret-key
# LANGFUSE_URL=https://cloud.langfuse.com
