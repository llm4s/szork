## Copy to `.env` and fill in values locally. Do NOT commit `.env`.

# LLM provider (choose one set)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# LLAMA_BASE_URL=http://localhost:11434

# Optional: explicit provider and model (defaults: gpt-4o / claude-sonnet-5-5 / llama3)
# SZORK_LLM_PROVIDER=openai   # openai | anthropic | llama
# SZORK_LLM_MODEL=gpt-4o

# Dungeon Master context window: how much of the game's conversation each model call is sent
# (the system prompt and adventure outline are always sent; the oldest turns are dropped first)
# SZORK_DM_CONTEXT_MAX_TOKENS=24000   # 0 or off sends the whole conversation
# SZORK_DM_CONTEXT_MAX_MESSAGES=      # if set, limits by message count instead of tokens

# Prompt-injection guardrail on player commands (llm4s PromptInjectionDetector); false or off disables
# SZORK_INPUT_GUARDRAIL=true

# Scene images (llm4s-image); unavailable unless a provider is set and has its credentials
# SZORK_IMAGE_GENERATION_ENABLED=true
# SZORK_IMAGE_PROVIDER=dalle3 # dalle3 | dalle2 (OPENAI_API_KEY) | huggingface | huggingface-sdxl | local | none
# HUGGINGFACE_API_KEY=hf_...    # or HF_API_KEY / HUGGINGFACE_TOKEN
# STABLE_DIFFUSION_URL=http://localhost:7860
# STABLE_DIFFUSION_API_KEY=

# Audio / speech (OpenAI, via llm4s-speech)
# SZORK_TTS_ENABLED=true
# SZORK_TTS_VOICE=nova
# SZORK_TTS_MODEL=tts-1
# SZORK_STT_ENABLED=true
# SZORK_STT_MODEL=whisper-1
# OPENAI_BASE_URL=

# Music (Replicate)
# SZORK_MUSIC_ENABLED=true
# REPLICATE_API_KEY=r8_...
# SZORK_MUSIC_POLL_MAX_ATTEMPTS=30
# SZORK_MUSIC_POLL_INTERVAL_MS=1000
# SZORK_MEDIA_CONNECT_TIMEOUT_MS=10000
# SZORK_MEDIA_READ_TIMEOUT_MS=30000

# Cache / saves
# SZORK_AUTO_SAVE=true
# SZORK_CACHE_ENABLED=true
# SZORK_CACHE_DIR=szork-cache
# SZORK_SAVES_DIR=szork-saves
# SZORK_CACHE_TTL_MS=604800000
# SZORK_CACHE_MAX_BYTES=524288000

# Server (listens on localhost only by default; set SZORK_HOST=0.0.0.0 to expose it)
# SZORK_PORT=8090
# SZORK_WS_PORT=9002
# SZORK_HOST=127.0.0.1
# Minutes a game's session lives with no connection (a reconnect within it carries on)
# SZORK_SESSION_TTL_MINUTES=30
# Browser origins allowed to open the WebSocket (comma-separated)
# SZORK_ALLOWED_ORIGINS=http://localhost:3090,http://127.0.0.1:3090

# Agent tracing, including scene image calls (off unless set): console | langfuse
# TRACING_MODE=langfuse
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_URL=https://cloud.langfuse.com
